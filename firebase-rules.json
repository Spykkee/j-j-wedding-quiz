{
  "_comment": [
    "Realtime Database rules for the J&J wedding quiz.",
    "",
    "Replace every occurrence of ADMIN_EMAIL_HERE with the email address of the",
    "account you created in Firebase console > Authentication > Users, then paste",
    "the whole file into Firebase console > Realtime Database > Rules > Publish.",
    "(The _comment keys are ignored by Firebase, so you can leave them in.)",
    "",
    "What these rules guarantee:",
    "  - the full quiz, with the correct answers in it, is readable only by you",
    "  - guests read only 'pub', which has no answers in it at all",
    "  - a guest can write their own team record and their own answer, nothing else",
    "  - a guest cannot write pts or state, so no phone can award itself points",
    "  - answers are only accepted while you have the question open",
    "",
    "Known and accepted: answers are world-readable, because the big screen is not",
    "signed in and needs to show who got it right. A guest with developer tools",
    "open could read another table's answer during a question."
  ],

  "rules": {
    "rooms": {
      "$room": {

        "quiz": {
          ".read": "auth != null && auth.token.email === 'ADMIN_EMAIL_HERE'",
          ".write": "auth != null && auth.token.email === 'ADMIN_EMAIL_HERE'"
        },

        "pub": {
          ".read": true,
          ".write": "auth != null && auth.token.email === 'ADMIN_EMAIL_HERE'"
        },

        "state": {
          ".read": true,
          ".write": "auth != null && auth.token.email === 'ADMIN_EMAIL_HERE'"
        },

        "adjust": {
          ".read": true,
          ".write": "auth != null && auth.token.email === 'ADMIN_EMAIL_HERE'"
        },

        "teams": {
          ".read": true,
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'ADMIN_EMAIL_HERE')",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 26"
            },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "answers": {
          ".read": true,
          "$qkey": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'ADMIN_EMAIL_HERE')",
              "value": {
                ".validate": "newData.isString() && newData.val().length <= 200 && (auth.token.email === 'ADMIN_EMAIL_HERE' || root.child('rooms/' + $room + '/state/open').val() === true)"
              },
              "at": { ".validate": "newData.isNumber()" },
              "name": { ".validate": "newData.isString() && newData.val().length <= 26" },
              "pts": {
                ".validate": "auth.token.email === 'ADMIN_EMAIL_HERE' && newData.isNumber()"
              },
              "state": {
                ".validate": "auth.token.email === 'ADMIN_EMAIL_HERE' && newData.isString() && newData.val().length <= 12"
              },
              "manual": {
                ".validate": "auth.token.email === 'ADMIN_EMAIL_HERE' && newData.isBoolean()"
              },
              "$other": { ".validate": false }
            }
          }
        }

      }
    }
  }
}
